# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kalaisbeautyacademy.com
NEXT_PUBLIC_WHATSAPP=919566229900

# Analytics — Vercel Analytics enabled in prod; Plausible gated until a domain exists.
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Razorpay stub — DISABLED. Booking is WhatsApp-only.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (HOSTED project — Project Settings → API)
# ─────────────────────────────────────────────────────────────────────────────
# Browser + server clients use these public values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER expose to the browser. Used by admin server actions + seeding.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Pooled Postgres connection string (Project Settings → Database → Connection string →
# "Transaction" pooler, port 6543). Used ONLY by scripts/migrate + scripts/verify to
# apply SQL to the hosted DB. Keep server-only.
# Example: postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Admin auth user (created by scripts/create-admin)
# ─────────────────────────────────────────────────────────────────────────────
# The admin's login email. The PASSWORD is NOT stored here — pass it at runtime:
#   ADMIN_PASSWORD=... npm run admin:create
# (or export it in your shell just for that command, then clear it).
ADMIN_EMAIL=admin@kalaisbeautyacademy.com
