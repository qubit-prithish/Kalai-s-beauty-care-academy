# Public site URL (used for canonical, hreflang, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kalaisbeautyacademy.com

# WhatsApp number (no +). Centralized booking number.
NEXT_PUBLIC_WHATSAPP=919566229900

# Analytics — Vercel Analytics on; Plausible env-gated (off until a domain exists).
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Razorpay stub — DISABLED. Online payment is not enabled (WhatsApp-only booking).
NEXT_PUBLIC_PAYMENTS_ENABLED=false


# ─── Supabase (admin dashboard + backend data) ───────────────────────────────
# Project URL and anon key are PUBLIC (safe to expose to the browser).
# Find them in: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is SECRET — server-only. Never prefix with NEXT_PUBLIC_ and
# never expose it to the browser. Used for privileged admin-membership checks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct Postgres connection string (server-only). Used for migrations / direct
# SQL tooling. The app itself talks to Supabase via the keys above, so this is
# optional for runtime. Find it in: Supabase Dashboard → Project Settings →
# Database → Connection string (use the pooled "Transaction" URI on Vercel).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres
